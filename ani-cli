  [ -n "\$_status" ] && _meta="\${_meta:+\$_meta | }\033[1;35m\$_status\033[0m"
  [ -n "\$_mal_id" ] && _meta="\${_meta:+\$_meta | }\033[1;30mMAL:\$_mal_id\033[0m"
  [ -n "\$_meta" ] && printf '%b\n' "\$_meta"
  [ -n "\$_genres" ] && printf '\033[1;37mGenres:\033[0m %s\n' "\$_genres"
