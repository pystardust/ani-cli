  if [ "\$thumbnail_preview" = 1 ] && [ -n "\$_img" ] && [ -n "\$_img_viewer" ]; then
    _img_file="\$_cache_dir/\${_id}.jpg"
    [ ! -s "\$_img_file" ] && \$curl_exe -sL -A "\$agent" --max-time 5 "\$_img" -o "\$_img_file" 2>/dev/null || true
    if [ -s "\$_img_file" ]; then
      case "\$_img_viewer" in
