    exit 0
}

version_info() {
    printf "%s\n" "$version_number"
    exit 0
}

# Bookkeeping

update_script() {
    info "[branch:$branch] Checking for Update.."
    update="$($curl_exe --fail-with-body -sL -A "$agent" "https://raw.githubusercontent.com/pystardust/ani-cli/$branch/ani-cli")" || die "[branch:$branch] Connection error: $update"
    new_version="$(printf "%s" "$update" | sed -nE 's|^version_number="([^"]+)"$|\1|p')"
    [ -z "$new_version" ] && die "[branch:$branch] Invalid response."
    printf "%s" "$update" | grep -q "^version_number" || die "[branch:$branch] Invalid response."
    update="$(printf "%s\n" "$update" | diff -u "$0" -)"
    if [ -z "$update" ]; then
        info "[branch:$branch] Script is up to date :) ($version_number)"
    else
        if printf "%s\n" "$update" | patch "$0" -; then
            info "[branch:$branch] Updated: $version_number -> $new_version"
        else
            die "[branch:$branch] Failed to update. Read the above line!"
        fi
    fi
    exit 0
}

# checks if dependencies are present
dep_ch() {
    command -v "$1" >/dev/null || die "Program $1 not found. Please install it."
}

# checks for deps in order and returns the first available. format is "prog_a,prog_b,prog_c"
dep_ch_failover() {
    [ -z "$1" ] && return 1
    prog=${1%%,*}
    command -v "$prog" >/dev/null 2>&1 && printf "%s" "$prog" && return 0
    [ -e "$prog" ] && printf "%s" "$prog" && return 0
    [ "$1" != "$prog" ] && dep_ch_failover "${1#*,}"
}

cleanup() {
    [ "$player_function" = "android_mpv" ] && : >"/storage/emulated/0/mpv/mpv.config.mp4" 2>/dev/null
    tput sgr0               # clears colors
    rm -f "${histfile}.new" # remove temp logfile
    [ -d "$miruro_tmpdir" ] && rm -rf "$miruro_tmpdir"
}

# a throwaway file inside this run's temp directory
miruro_tmp() {
    [ -d "$miruro_tmpdir" ] || mkdir -p "$miruro_tmpdir" || return 1
    mktemp "$miruro_tmpdir/$1.XXXXXX"
}

# SCRAPING

# parse playlist content ($1, served from $2): sets links (quality >url
# per line), m3u8_links's non-fatal core
m3u8_parse() {
    # a non-playlist body (error page, block page) must never masquerade as
    # a default source; require the HLS magic so callers walk on
    case "$1" in *#EXTM3U*) : ;; *)
        links=""
        return 1
        ;;
    esac
    if printf "%s" "$1" | grep -q "#EXT-X-STREAM-INF"; then
        # per RFC 3986: an absolute URL passes through, an absolute path
        # (/x) sits under the master's scheme://host, and a relative one
        # under the master's directory
        _m3u8_host="${2#*://}"
        _m3u8_host="${_m3u8_host%%/*}"
        _m3u8_root="${2%%://*}://${_m3u8_host}"
        links="$(printf "%s\n" "$1" | tr -d '\r' | sed -nE '
/^#EXT-X-STREAM-INF:/ {
    s|.*RESOLUTION=[0-9]+x([0-9]+).*|\1p|
    t quality
    s|.*|default|
    :quality
    h
    b
}
/^#/d
/^[[:space:]]*$/d
G
s|^(.*)\n(.*)$|\2 >\1|p' | sed \
            -e "\|>https*://|!s|>\(/[^\" ]*\)|>${_m3u8_root}\1|" \
            -e "\|>https*://|!s|>|>${2%/*}/|" | sort -g -r -s)"
    elif [ -n "$1" ]; then
        links="default >$2"
    else
        links=""
    fi
    [ -n "$links" ]
}

# fetch a URL with the browser headers miruro expects, printing the body
miruro_fetch() {
    _curl_status=0
    if [ -n "$miruro_chunk" ]; then
        _mf_pipe="$(miruro_tmp pipe)"
        rm -f "$_mf_pipe"
        mkfifo "$_mf_pipe" || return 1
        $curl_exe -sL --fail --compressed -A "$agent" --connect-timeout 8 --max-time 30 ${cipher_flag:+$cipher_flag} \
            -w '%{stderr}%{http_code}' "$@" >"$_mf_pipe" 2>"$_mf_pipe.status" &
        _mf_pid=$!
        _mf_body="$(slot_chunk "$miruro_chunk" <"$_mf_pipe")"
        kill "$_mf_pid" 2>/dev/null
        wait "$_mf_pid" 2>/dev/null || _curl_status=$?
        rm -f "$_mf_pipe"
        [ -n "$_mf_body" ] && printf "%s" "$_mf_body" && return 0
        _mf_body=" $(cat "$_mf_pipe.status")"
    else
        _mf_body="$($curl_exe -sL --compressed -A "$agent" --connect-timeout 8 --max-time 30 ${cipher_flag:+$cipher_flag} \
            -w ' %{http_code}' "$@" 2>/dev/null)" || _curl_status=$?
    fi
    _http_code=${_mf_body##* }
    _mf_body=${_mf_body% *}
    if [ "$_curl_status" -ne 0 ]; then
        case "$_http_code" in
            [1-5][0-9][0-9]) _detail="HTTP $_http_code" ;;
            *) _detail="no HTTP response" ;;
        esac
        printf "Connection error: could not fetch %s (%s; curl exit %s)\n" "$1" "$_detail" "$_curl_status" >&2
        return 1
    fi
    case "$_http_code" in
        2??) ;;
        *)
            printf "Request failed: HTTP %s from %s\n" "$_http_code" "$1" >&2
            return 1
            ;;
    esac
    if printf "%s" "$_mf_body" | grep -qiE 'Just a moment|Attention Required!'; then
        [ "$curl_exe" = "curl" ] && printf "Blocked by cloudflare. Try installing curl-impersonate\n" >&2 || printf "Blocked by cloudflare.\n" >&2
        return 1
    fi
    [ -n "$_mf_body" ] || return 1
    printf "%s" "$_mf_body"
}

slot_escape() {
    sed -e 's|\\\\|@|g' -e 's|\\"|@|g'
}

slot_extract() {
    sed -nE 's|^.*"data":\[||
s|\],"uses":.*$||
s|(.*)]\}$|\1|
p'
}

slot_split() {
    tr ',' '\n' |
        sed -E ':a
/^([^"]*("[^"]*"[^"]*)*"[^"]*|\[(.*[^]])?|\{(.*[^}])?)$/ {
N
s|\n|,|
ba
}'
}

slot_load() {
    slot_extract | slot_escape | slot_split >"$1" && [ -s "$1" ]
}

slot_at() {
    sed -n "$(($1 + 1)){p;q;}" "$2"
}

slot_member() {
    _sn_value="${1#*"\"$2\":"}"
    [ "$_sn_value" = "$1" ] && return 1
    _sn_value="${_sn_value%%,*}"
    _sn_value="${_sn_value%%\}*}"
    case "$_sn_value" in
        '' | *[!0-9]*) return 1 ;;
        *) ;;
    esac
    printf "%s" "$_sn_value"
}

slot_follow() {
    _sf_ref="$(slot_member "$1" "$3")" || return 1
    slot_at "$_sf_ref" "$2"
}

slot_list() {
    printf "%s" "$1" | tr -d '[]' | tr ',' '\n'
}

slot_value() {
    sed -e 's|^null$||' -e 's|^"||' -e 's|"$||' -e 's|\\n| |g' -e 's|\\r| |g' -e 's|\\t| |g'
}

# batch slot reader: line numbers of a flat slot file, from slot_list-style refs
# ("2 11 18" -> "-e 2p -e 11p -e 18p"); callers feed the refs list once
slot_lines() {
    slot_list "$1" | sed -e '/[0-9]/!d' -e 's|.*|-e &p|'
}

slot_chunk() {
    case "$1" in
        tracks) _mm_key="episodeNumber" ;;
        *) _mm_key="$1" ;;
    esac
    grep -m 1 -E '^\{"type":"chunk","id":[0-9]+,"data":\[\{"'"$_mm_key"'":.*\]\}$|^\{"type":"redirect","location":"[^"]+"\}$'
}

miruro_redirect_slug() {
    _mr_loc="$(printf "%s" "$1" | sed -nE 's|.*"location":"([^"]+)".*|\1|p' | head -n 1)"
    [ -z "$_mr_loc" ] && return 0
    _mr_loc="${_mr_loc#*watch/}"
    _mr_loc="${_mr_loc%%\?*}"
    _mr_loc="${_mr_loc%/}"
    printf "%s" "${_mr_loc#*/}"
}

miruro_map_write() {
    [ -n "$1" ] || return 0
    _mw_tmp="$(mktemp "${TMPDIR:-/tmp}/mm-map-XXXXXX")"
    if [ -f "$miruro_map" ]; then
        grep -vE "^$1	" "$miruro_map" 2>/dev/null >"$_mw_tmp"
    fi
    printf "%s\t%s\t%s\t%s\n" "$1" "${2:-}" "${3:-}" "${4:-}" >>"$_mw_tmp"
    mv "$_mw_tmp" "$miruro_map"
}

miruro_item_title() {
    _mi_map="$(slot_follow "$1" "$2" title)" || return 1
    for _mi_key in english romaji native; do
        _mi_title="$(slot_follow "$_mi_map" "$2" "$_mi_key" | slot_value)" || continue
        [ -z "$_mi_title" ] && continue
        printf "%s" "$_mi_title"
        return 0
    done
    return 1
}

miruro_ext_pick() {
    _mp_list="$(slot_follow "$1" "$2" "$3")" || return 1
    for _mp_e in $(slot_list "$_mp_list"); do
        [ -n "$_mp_e" ] || continue
        _mp_txt="$(slot_at "$_mp_e" "$2" 2>/dev/null)" || continue
        case "$_mp_txt" in
            \"*\"*)
                _mp_val="$(printf "%s" "$_mp_txt" | slot_value)"
                [ -n "$_mp_val" ] || continue
                printf "%s" "$_mp_val"
                return 0
                ;;
            *) ;;
        esac
    done
    return 1
}

miruro_search() {
    _mm_query="$(printf "%s" "$1" | tr '+' ' ')"
    _mm_page="$(miruro_fetch "$miruro_base/search/__data.json" --get --data-urlencode "q=$_mm_query")" ||
        die "miruro: connection error"
    [ -z "$_mm_page" ] && return 1
    _mm_slots="$(miruro_tmp search)"
    printf "%s" "$_mm_page" | slot_load "$_mm_slots" || return 1
    _mm_root="$(slot_at 0 "$_mm_slots")"
    _mm_items="$(slot_follow "$_mm_root" "$_mm_slots" items)" || return 1
    for _mm_idref in $(slot_list "$_mm_items"); do
        _mm_item="$(slot_at "$_mm_idref" "$_mm_slots")"
        _mm_ext="$(slot_follow "$_mm_item" "$_mm_slots" external_ids)" || continue
        _mm_al="$(miruro_ext_pick "$_mm_ext" "$_mm_slots" anilist)" || continue
        _mm_show="$(slot_follow "$_mm_item" "$_mm_slots" id | slot_value)" || continue
        [ -z "$_mm_show" ] && continue
        _mm_mal="$(miruro_ext_pick "$_mm_ext" "$_mm_slots" mal)"
        miruro_map_write "$_mm_al" "$_mm_show" "" "$_mm_mal"
        _mm_title="$(miruro_item_title "$_mm_item" "$_mm_slots")" || continue
        printf "%s\t%s\n" "$_mm_al" "$_mm_title"
    done
}

miruro_show_by_titles() {
    [ -n "$2" ] || return 1
    miruro_search "$2" >/dev/null
    grep -q -E "^$1	" "$miruro_map" 2>/dev/null
}

miruro_resolve() {
    miruro_show=""
    miruro_slug=""
    miruro_mal=""
    [ -n "$1" ] || return 1
    _mm_row="$(grep -m 1 -E "^$1	" "$miruro_map" 2>/dev/null)"
    if [ -z "$_mm_row" ]; then
        # a show seen for the first time is found through its title
        miruro_show_by_titles "$1" "$2"
        _mm_row="$(grep -m 1 -E "^$1	" "$miruro_map" 2>/dev/null)"
    fi
    miruro_show="$(printf "%s" "$_mm_row" | cut -f 2)"
    miruro_slug="$(printf "%s" "$_mm_row" | cut -f 3)"
    miruro_mal="$(printf "%s" "$_mm_row" | cut -f 4)"
    [ -n "$miruro_show" ] || return 1
    if [ -z "$miruro_slug" ]; then
        _mm_body="$(miruro_fetch "$miruro_base/watch/$miruro_show/x/__data.json?ep=1")" || return 1
        miruro_slug="$(miruro_redirect_slug "$_mm_body")"
        [ -z "$miruro_slug" ] && miruro_slug="x"
    fi
    miruro_map_write "$1" "$miruro_show" "$miruro_slug" "$miruro_mal"
}

# fetch the watch payload for episode $2 of show $1 (titled $3); a re-slugged
# show is followed once
miruro_watch() {
    miruro_resolve "$1" "$3" || return 1
    _mm_body="$(miruro_chunk="$4" miruro_fetch "$miruro_base/watch/$miruro_show/$miruro_slug/__data.json?ep=$2" 2>/dev/null)" ||
        _mm_body="$(miruro_chunk="$4" miruro_fetch "$miruro_base/watch/$miruro_show/x/__data.json?ep=1")" || return 1
    _mm_slug="$(miruro_redirect_slug "$_mm_body")"
    if [ -n "$_mm_slug" ]; then
        miruro_slug="$_mm_slug"
        miruro_map_write "$1" "$miruro_show" "$miruro_slug" "$miruro_mal"
        _mm_body="$(miruro_chunk="$4" miruro_fetch "$miruro_base/watch/$miruro_show/$miruro_slug/__data.json?ep=$2")" || return 1
    fi
    printf "%s" "$_mm_body"
}

miruro_episodes() {
    _mm_cache="$hist_dir/miruro-episodes.$1"
    _mm_now="$(date +%s)" || return 1
    if [ -s "$_mm_cache" ]; then
        read -r _mm_time <"$_mm_cache"
        [ "$_mm_time" -gt "$((_mm_now - 300))" ] 2>/dev/null && tail -n +2 "$_mm_cache" && return 0
    fi
    _mm_payload="$(miruro_watch "$1" 1 "$2" episodes)" || die "miruro: could not load the episode list"
    _mm_slots="$(miruro_tmp slots)"
    _mm_line="$(printf "%s\n" "$_mm_payload" | slot_chunk episodes)"
    [ -n "$_mm_line" ] || die "miruro: no episode chunk in the watch payload"
    printf "%s\n" "$_mm_line" | slot_load "$_mm_slots" || die "miruro: malformed episode chunk"
    _mm_root="$(slot_at 0 "$_mm_slots")"
    _mm_eps="$(slot_follow "$_mm_root" "$_mm_slots" episodes)" || die "miruro: no episode roster"

    _mm_sheet="$(miruro_tmp sheet)"
    tail -n +2 "$_mm_slots" >"$_mm_sheet"
    _mm_prog="$(slot_lines "$_mm_eps")"
    #shellcheck disable=SC2086
    _mm_nodes="$(sed -n $_mm_prog "$_mm_sheet")"
    _mm_refs="$(printf "%s\n" "$_mm_nodes" | sed -nE 's|.*"number":([0-9]+).*|\1|p')"
    _mm_prog="$(slot_lines "$_mm_refs")"
    #shellcheck disable=SC2086
    _mm_nos="$(sed -n $_mm_prog "$_mm_sheet")"
    printf "%s\n" "$_mm_nos" | slot_value | sed -nE '/^[0-9]+([.][0-9]+)?$/ {
        /^0$/d
        s|.*|&	&|p
    }' | sort -nu >"$miruro_tmpdir/episodes.$1"
    [ -s "$miruro_tmpdir/episodes.$1" ] || return 1
    {
        printf "%s\n" "$_mm_now"
        cat "$miruro_tmpdir/episodes.$1"
    } >"$_mm_cache.$$"
    mv "$_mm_cache.$$" "$_mm_cache"
    cat "$miruro_tmpdir/episodes.$1"
}

miruro_sub_pick() {
    _mm_subs="$(slot_follow "$1" "$2" subtitles)" || return 0
    _mi_default=""
    _mi_first=""
    for _mm_subref in $(slot_list "$_mm_subs"); do
        _mm_sub="$(slot_at "$_mm_subref" "$2")"
        _mm_file="$(slot_follow "$_mm_sub" "$2" file | slot_value 2>/dev/null)"
        _mm_low="$(printf "%s" "$_mm_file" | tr '[:upper:]' '[:lower:]')"
        case "$_mm_low" in
            */video.m3u8* | *.m3u8* | *.mpd* | *.mp4* | *.m4s* | *.webm* | *.mkv*) continue ;;
            *.vtt* | *.srt* | *.ass* | *.ssa* | *.ttml* | *.dfxp* | *.sbv* | *.lrc* | *sub*) ;;
            *) continue ;;
        esac
        [ -z "$_mi_first" ] && _mi_first="$_mm_file"
        _mi_lang="$(slot_follow "$_mm_sub" "$2" language | slot_value 2>/dev/null)"
        case "$_mi_lang" in
            en*) printf "%s" "$_mm_file" && return 0 ;;
            *) ;;
        esac
        if [ -z "$_mi_default" ]; then
            _mi_is_default="$(slot_follow "$_mm_sub" "$2" default 2>/dev/null)"
            case "$_mi_is_default" in
                true) _mi_default="$_mm_file" ;;
                *) ;;
            esac
        fi
    done
    printf "%s" "${_mi_default:-${_mi_first}}"
}

miruro_servers() {
    case "$3" in
        dub) _ms_wanted="dub" ;;
        *) _ms_wanted="sub ssub" ;;
    esac
    for _ms_trackref in $(slot_list "$1"); do
        _ms_track="$(slot_at "$_ms_trackref" "$2")"
        _ms_pool="$(slot_follow "$_ms_track" "$2" track | slot_value 2>/dev/null)"
        case " $_ms_wanted " in *" $_ms_pool "*) ;; *) continue ;; esac
        _ms_provs="$(slot_follow "$_ms_track" "$2" providers)" || continue
        for _ms_provref in $(slot_list "$_ms_provs"); do
            _ms_prov="$(slot_at "$_ms_provref" "$2")"
            _ms_servers="$(slot_follow "$_ms_prov" "$2" servers)" || continue
            for _ms_srvref in $(slot_list "$_ms_servers"); do
                _ms_srv="$(slot_at "$_ms_srvref" "$2")"
                _ms_headers="$(slot_follow "$_ms_srv" "$2" headers)"
                _ms_refr=""
                case "$_ms_headers" in
                    '{'*)
                        _ms_refr="$(slot_follow "$_ms_headers" "$2" Referer | slot_value 2>/dev/null)"
                        [ -n "$_ms_refr" ] || _ms_refr="$(slot_follow "$_ms_headers" "$2" Origin | slot_value 2>/dev/null)"
                        ;;
                    *) ;;
                esac
                _ms_name="$(slot_follow "$_ms_srv" "$2" server | slot_value)"
                _ms_rank=1
                case "$_ms_pool:$_ms_name" in
                    sub:*-cloudflare-1 | ssub:Vidstream-2) _ms_rank=0 ;;
                    *) ;;
                esac
                printf "%s\t%s\t%s\t%s\t%s\n" "$_ms_rank" "$_ms_pool" "$_ms_provref" "$_ms_srvref" "$_ms_refr"
            done
        done
    done
}

miruro_streams() {
    _mt_found=0
    _mt_srv="$(slot_at "$1" "$2")"
    _mt_streams="$(slot_follow "$_mt_srv" "$2" streams)" || return 1
    for _mt_stref in $(slot_list "$_mt_streams"); do
        _mt_stream="$(slot_at "$_mt_stref" "$2")"
        _mt_url="$(slot_follow "$_mt_stream" "$2" url | slot_value 2>/dev/null)"
        case "$_mt_url" in http*) ;; *) continue ;; esac
        _mt_fmt="$(slot_follow "$_mt_stream" "$2" format | slot_value 2>/dev/null)"
        case "$_mt_fmt$_mt_url" in
            *mp4*) links="default >$_mt_url" ;;
            *hls* | *".m3u8"*)
                if [ -n "$3" ]; then
                    _mt_pl="$(miruro_fetch "$_mt_url" -e "$3" --max-time 10)" || continue
                else
                    _mt_pl="$(miruro_fetch "$_mt_url" --max-time 10)" || continue
                fi
                m3u8_parse "$_mt_pl" "$_mt_url" || continue
                ;;
            *) continue ;;
        esac
        printf "%s\n" "$links"
        _mt_found=1
    done
    [ "$_mt_found" = 1 ]
}

miruro_source() (
    _mc_links="$(miruro_streams "$3" "$5" "$4")" || exit 1
    _mc_prov="$(slot_at "$2" "$5")"
    _mc_name="$(slot_follow "$_mc_prov" "$5" provider | slot_value)"
    _mc_srv="$(slot_at "$3" "$5")"
    _mc_server="$(slot_follow "$_mc_srv" "$5" server | slot_value)"
    _mc_sub=""
    [ "$1" = ssub ] && _mc_sub="$(miruro_sub_pick "$_mc_prov" "$5")"
    case "$1" in
        sub) _mc_kind="h-sub" ;;
        ssub) _mc_kind="soft-sub" ;;
        *) _mc_kind="$1" ;;
    esac
    printf "%s\n" "$_mc_links" | while IFS= read -r _mc_link; do
        _mc_choice="${_mc_link%%>*}[$_mc_kind/$_mc_name/$_mc_server] >${_mc_link#*>}"
        printf "%s\t%s\t%s\n" "$_mc_choice" "$4" "$_mc_sub"
    done
)

miruro_media() {
    sub_link=""
    mal_id=""
    _mm_al="${anime_id#*:}"
    [ -n "$_mm_al" ] && [ -f "$miruro_map" ] &&
        mal_id="$(grep -m 1 -E '^'"$_mm_al"'	' "$miruro_map" 2>/dev/null | cut -f 4)"
    _mm_payload="$(miruro_watch "$_mm_al" "$1" "${anime_title:-}" tracks)" || return 1
    _mm_slots="$(miruro_tmp tracks)"
    _mm_line="$(printf "%s\n" "$_mm_payload" | slot_chunk tracks)"
    [ -n "$_mm_line" ] || return 1
    printf "%s\n" "$_mm_line" | slot_load "$_mm_slots" || return 1
    _mm_root="$(slot_at 0 "$_mm_slots")"
    _mm_tracks="$(slot_follow "$_mm_root" "$_mm_slots" tracks)" || return 1
    _mm_servers="$(miruro_servers "$_mm_tracks" "$_mm_slots" "$2" | sort -s -k2,2r -k1,1n -k5,5 | cut -f 2-)"
    [ -n "$_mm_servers" ] || return 1
    rm -f "$miruro_tmpdir"/source.*
    _mm_count=0
    _mm_pids=""
    while read -r _mm_pool _mm_provref _mm_srvref _mm_refr; do
        _mm_count=$((_mm_count + 1))
        miruro_source "$_mm_pool" "$_mm_provref" "$_mm_srvref" "$_mm_refr" "$_mm_slots" >"$miruro_tmpdir/source.$(printf '%06d' "$_mm_count")" 2>/dev/null &
        _mm_pids="$_mm_pids $!"
        if [ $((_mm_count % 4)) -eq 0 ]; then
            for _mm_pid in $_mm_pids; do wait "$_mm_pid"; done
            _mm_pids=""
        fi
    done <<EOF
$_mm_servers
EOF
    for _mm_pid in $_mm_pids; do wait "$_mm_pid"; done
    miruro_sources="$miruro_tmpdir/sources"
    cat "$miruro_tmpdir"/source.* >"$miruro_sources"
    links="$(cut -f 1 "$miruro_sources")"
    [ -n "$links" ]
}

# select the quality according to the setting
select_quality() {
    case "$1" in
        best) _result=$(printf "%s" "$links" | head -n 1) ;;
        worst) _result=$(printf "%s" "$links" | grep -E '^[0-9]{3,4}' | sort -s -k1,1n | head -n 1) ;;
        *' >'*) _result=$(printf "%s\n" "$links" | grep -F -x -m 1 -- "$1") ;;
        *) _result=$(printf "%s" "$links" | grep -F -m 1 -- "$1") ;;
    esac
    [ -z "$_result" ] && printf "\33[2K\r\033[1;33m%s\033[0m\n" "$1 not found, defaulting to best" >&2 && _result=$(printf "%s" "$links" | head -n 1)

    video_link="${_result#*>}"
    refr=""
    sub_link=""
    [ -f "$miruro_sources" ] || return 0
    while IFS= read -r _sq_row; do
        case "$_sq_row" in
            "$_result	"*)
                _sq_row="${_sq_row#*	}"
                refr="${_sq_row%%	*}"
                sub_link="${_sq_row#*	}"
                break
                ;;
            *) ;;
        esac
    done <"$miruro_sources"
}

# gets embed url, collects direct links and selects one with desired quality into $episode
get_video_link() {
    miruro_media "$ep_no" "$mode" || die "No sources found for $mode!"
    info "miruro links fetched"
    select_quality "$quality"
    # should never trigger but just in case
    if printf "%s" "$ep_list" | grep -q "^$ep_no$"; then
        [ -z "$video_link" ] && die "Episode is released, but no valid sources!"
    else
        [ -z "$video_link" ] && die "Episode not released!"
    fi
}

# provide countdown for the next episode release both sub and dub
time_until_next_ep() {
    animeschedule="https://animeschedule.net"
    _query="$(printf "%s" "$*" | tr ' ' '+')"
    $curl_exe -s -G "$animeschedule/api/v3/anime" --data "q=${_query}" | sed 's|},{"id"|\n|g' | while read -r _entry; do
        _route=$(printf "%s" "$_entry" | sed -nE 's|.*"route":"([^"]*)",.*|\1|p')
        _eng_title=$(printf '%s' "$_entry" | sed -nE 's|.*"english":"([^"]*)".*|\1|p')
        [ -z "$_eng_title" ] && _eng_title=$(printf '%s' "$_entry" | sed -nE 's|.*,"title":"([^"]*)".*|\1|p')
        [ -z "$_eng_title" ] && _eng_title="N/A"
        _jpn_title=$(printf '%s' "$_entry" | sed -nE 's|.*"romaji":"([^"]*)".*|\1|p')
        [ -z "$_jpn_title" ] && _jpn_title="N/A"
        _status=$(printf '%s' "$_entry" | sed -nE 's|.*"status":"([^"]*)".*|\1|p')
        [ -z "$_status" ] && _status="Unknown"

        case "$_status" in
            Ongoing) _color="33" ;;
            Finished) _color="32" ;;
            *) _color="36" ;;
        esac

        printf "Eng: %s\n" "$_eng_title"
        printf "Jpn: %s\n" "$_jpn_title"
        printf "Status: \033[1;%sm%s\033[0m\n" "$_color" "$_status"

        if [ "$_status" != "Finished" ]; then
            _page="$($curl_exe -s "$animeschedule/anime/$_route")"
            _sub_ep=$(printf "%s" "$_page" | sed -nE 's|.*release-time-type-subs"[^>]*><span class="release-time-episode-number">Episode ([0-9]+)</span>.*|\1|p' | head -n 1)
            _dub_ep=$(printf "%s" "$_page" | sed -nE 's|.*release-time-type-dub"[^>]*><span class="release-time-episode-number">Episode ([0-9]+)</span>.*|\1|p' | head -n 1)
            _sub_countdown=$(printf "%s" "$_page" | sed -nE 's|.*class="countdown-time" datetime="([^"]*)".*|\1|p' | head -n 1)
            _dub_countdown=$(printf "%s" "$_page" | sed -nE 's|.*class="countdown-time countdown-time-dub" datetime="([^"]*)".*|\1|p' | head -n 1)

            [ -n "$_sub_ep" ] && [ -n "$_sub_countdown" ] &&
                printf "Next Sub: Episode %s in \033[1;%sm%s\033[0m\n" "$_sub_ep" "$_color" "$_sub_countdown" || printf "Next Sub: N/A\n"
            [ -n "$_dub_ep" ] && [ -n "$_dub_countdown" ] &&
                printf "Next Dub: Episode %s in \033[1;%sm%s\033[0m\n" "$_dub_ep" "$_color" "$_dub_countdown" || printf "Next Dub: N/A\n"
        fi
        printf "\n"
    done
    exit 0
}

# HISTORY

# lowercase, punctuation-free form of a title, for loose matching
norm_title() {
    printf "%s" "$1" | sed 's| BD$||' | tr '[:upper:]' '[:lower:]' | tr -cs '[:alnum:]' ' ' | tr -s ' ' | sed 's|^ ||; s| $||'
}

# print "id<TAB>title - episode N" for the next unwatched episode of a row
process_hist_entry() {
    _entry_ep="$1"
    _entry_id="$2"
    _entry_title="$3"
    case "$_entry_id" in
        '' | *[!0-9]*)
            # older providers stored a site slug: look the show up by its title
            _entry_norm="$(norm_title "$_entry_title")"
            _entry_query="$(printf "%s" "$_entry_title" | sed 's| BD$||; s| |+|g')"
            _entry_all="$(miruro_search "$_entry_query")" || return 1
            _entry_id="$(printf "%s\n" "$_entry_all" | while IFS="$(printf '\t')" read -r _id _title; do
                _entry_hit_norm="$(norm_title "$_title")"
                [ "$_entry_hit_norm" = "$_entry_norm" ] && {
                    printf "%s\n" "$_id"
                    break
                }
            done)"
            [ -n "$_entry_id" ] || return 1
            ;;
        *) ;;
    esac
    _entry_eps="$(miruro_episodes "$_entry_id" "$_entry_title")" || return 1
    _entry_next="$(printf "%s" "$_entry_eps" | cut -f 2 | sed -n "/^${_entry_ep}$/{n;p;}")"
    [ -n "$_entry_next" ] && printf "%s\t%s - episode %s\n" "$_entry_id" "$_entry_title" "$_entry_next"
}

update_history() {
    # drop this show's old row and any legacy slug row with the same title
    : >"${histfile}.new"
    while IFS="$(printf '\t')" read -r _hist_ep _hist_id _hist_title; do
        [ "$_hist_id" = "$anime_id" ] && continue
        if [ "$_hist_title" = "$anime_title" ]; then
            case "$_hist_id" in
                '' | *[!0-9]*) continue ;;
                *) ;;
            esac
        fi
        printf "%s\t%s\t%s\n" "$_hist_ep" "$_hist_id" "$_hist_title" >>"${histfile}.new"
    done <"$histfile"
    printf "%s\t%s\t%s\n" "$ep_no" "$anime_id" "$anime_title" >>"${histfile}.new"
    mv "${histfile}.new" "$histfile"
}

# PLAYING

# shellcheck disable=SC2086
# $1 = video link, $2 = video name, $3 = extra flags
download() {
    _name="$(printf "%s" "$2" | tr '<>:"/\\|?*' '_')"
    [ -n "$sub_link" ] && $curl_exe -sL -A "$agent" -e "$refr" --max-time 10 $cipher_flag "$sub_link" -o "$download_dir/$_name.vtt"
    [ -z "$audio_link" ] && command -v "yt-dlp" >/dev/null && yt-dlp --referer "$refr" "$1" --no-skip-unavailable-fragments --fragment-retries infinite -N 16 -P "$download_dir" -P "temp:$tmp_dir" -o "$_name.mp4" $3 && return 0
    ffmpeg -extension_picky 0 -referer "$refr" -loglevel error -stats -i "$1" ${audio_link:+-extension_picky 0 -referer "$refr" -i "$audio_link"} -c copy "$download_dir/$_name.mp4" $3
}

# mpv-android takes no options from the intent, so they go through a file the user includes in mpv.conf
# shellcheck disable=SC2086
android_mpv() {
    _conf_dir="/storage/emulated/0/mpv"
    if [ -w "${_conf_dir%/mpv}" ]; then
        [ -d "$_conf_dir" ] || mkdir "$_conf_dir"
        printf "referrer=%s\n%s\n%s\n" "$refr" "${sub_link:+sub-file=$sub_link}" "${audio_link:+audio-file=$audio_link}" >"$_conf_dir/mpv.config.mp4"
    fi
    nohup am start --user 0 -a android.intent.action.VIEW -d "$video_link" -n is.xyz.mpv/.MPVActivity -e "title" "${anime_title} Episode ${ep_no}" $player_extra_flags >/dev/null 2>&1 &
}

play_episode() {
    [ "$log_episode" = 1 ] && [ "$player_function" != "debug" ] && [ "$player_function" != "download" ] && command -v logger >/dev/null && logger -t ani-cli "${anime_title} ${ep_no}"
    [ -z "$video_link" ] && get_video_link
    [ "$skip_intro" = 1 ] && skip_flag="$(ani-skip -i "$mal_id" -e "$ep_no")"
    # wait for the previous player to close (in range selection)
    wait
    # shellcheck disable=SC2086
    case "$player_function" in
        debug) printf "All links:\n%s\nSelected link:\n%s\nAudio:\n%s\nSubtitles:\n%s\n" "$links" "$video_link" "$audio_link" "$sub_link" ;;
        android_mpv) android_mpv ;;
        android_vlc) nohup am start --user 0 -a android.intent.action.VIEW -d "$video_link" -n org.videolan.vlc/org.videolan.vlc.gui.video.VideoPlayerActivity -e "title" "${anime_title} Episode ${ep_no}" $player_extra_flags >/dev/null 2>&1 & ;;
        *flatpak*mpv*) flatpak run io.mpv.Mpv --referrer="$refr" ${audio_link:+--audio-file="$audio_link"} ${sub_link:+--sub-file="$sub_link"} $skip_flag $player_extra_flags --force-media-title="${anime_title} Episode ${ep_no}" "$video_link" >/dev/null 2>&1 & ;;
        *mpv*)
            if [ "$no_detach" = 0 ]; then
                nohup $player_function --referrer="$refr" ${audio_link:+--audio-file="$audio_link"} ${sub_link:+--sub-file="$sub_link"} $skip_flag $player_extra_flags --force-media-title="${anime_title} Episode ${ep_no}" "$video_link" >/dev/null 2>&1 &
            else
                $player_function --referrer="$refr" ${audio_link:+--audio-file="$audio_link"} ${sub_link:+--sub-file="$sub_link"} $skip_flag $player_extra_flags --force-media-title="${anime_title} Episode ${ep_no}" "$video_link"
                mpv_exitcode=$?
                [ "$exit_after_play" = 1 ] && [ -z "$_range" ] && exit "$mpv_exitcode"
            fi
            ;;
        *iina*)
            # mpv splits sub-files on ':', so the url has to be escaped for iina
            _sub_iina="$(printf "%s" "$sub_link" | sed 's|:|\\:|g')"
            _audio_iina="$(printf "%s" "$audio_link" | sed 's|:|\\:|g')"
            if pgrep -f "IINA" >/dev/null 2>&1; then
                # omit --keep-running when an IINA instance exists to prevent hanging
                nohup $player_function --mpv-referrer="$refr" ${_audio_iina:+--mpv-audio-files="$_audio_iina"} ${_sub_iina:+--mpv-sub-files="$_sub_iina"} $player_extra_flags --no-stdin --mpv-force-media-title="${anime_title} Episode ${ep_no}" "$video_link" >/dev/null 2>&1 &
            else
                nohup $player_function --mpv-referrer="$refr" ${_audio_iina:+--mpv-audio-files="$_audio_iina"} ${_sub_iina:+--mpv-sub-files="$_sub_iina"} $player_extra_flags --no-stdin --keep-running --mpv-force-media-title="${anime_title} Episode ${ep_no}" "$video_link" >/dev/null 2>&1 &
            fi
            ;;
        *vlc*) nohup $player_function --http-referrer="$refr" $player_extra_flags --play-and-exit --meta-title="${anime_title} Episode ${ep_no}" "$video_link" :input-slave="${audio_link:+$audio_link#}$sub_link" >/dev/null 2>&1 & ;;
        *yncpla*) nohup $player_function $player_extra_flags "$video_link" -- $skip_flag --referrer="$refr" ${audio_link:+--audio-file="$audio_link"} ${sub_link:+--sub-file="$sub_link"} --force-media-title="${anime_title} Episode ${ep_no}" >/dev/null 2>&1 & ;;
        download) "$player_function" "$video_link" "${anime_title} Episode ${ep_no}" $player_extra_flags ;;
        catt) nohup catt cast $player_extra_flags "$video_link" >/dev/null 2>&1 & ;;
        iSH)
            printf "\033]8;;vlc://%s\a~~~~~~~~~~~~~~~~~~~~\n~ Tap to open VLC ~\n~~~~~~~~~~~~~~~~~~~~\033]8;;\a\n" "$video_link"
            sleep 5
            ;;
        *) nohup $player_function $player_extra_flags "$video_link" >/dev/null 2>&1 & ;;
    esac
    replay="$video_link"
    unset video_link
    update_history
    [ "$menu_program" != "fzf" ] && wait
}

play() {
    _start=$(printf "%s" "$ep_no" | grep -Eo '^(-1|[0-9]+(\.[0-9]+)?)')
    _end=$(printf "%s" "$ep_no" | grep -Eo '(-1|[0-9]+(\.[0-9]+)?)$')
    [ "$_start" = "-1" ] && ep_no=$(printf "%s" "$ep_list" | tail -n 1) && unset _start
    [ -z "$_end" ] || [ "$_end" = "$_start" ] && unset _start _end
    [ "$_start" = "0" ] && _start=$(printf "%s" "$ep_list" | head -n 1)
    [ "$_end" = "-1" ] && _end=$(printf "%s" "$ep_list" | tail -n 1)
    _line_count=$(printf "%s\n" "$ep_no" | wc -l | tr -d "[:space:]")
    if [ "$_line_count" != 1 ] || [ -n "$_start" ]; then
        [ -z "$_start" ] && _start=$(printf "%s\n" "$ep_no" | head -n 1)
        [ -z "$_end" ] && _end=$(printf "%s\n" "$ep_no" | tail -n 1)
        _range=$(printf "%s\n" "$ep_list" | sed -nE "/^${_start}\$/,/^${_end}\$/p")
        [ -z "$_range" ] && die "Invalid range!"
        for i in $_range; do
            tput clear
            ep_no=$i
            info "Playing episode $ep_no..."
            [ "$i" = "$_end" ] && unset _range
            play_episode
        done
    else
        printf "%s" "$ep_list" | grep -q "^$ep_no$" || die "Invalid episode!"
        play_episode
    fi
    # moves up to stored position and deletes to end
    [ "$player_function" != "debug" ] && [ "$player_function" != "download" ] && tput rc && tput ed
}

